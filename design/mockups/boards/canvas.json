 "notes": {
  "titleReel": {
   "x": 0,
   "y": -250,
   "text": "A. The Daily Reel",
   "kind": "title1",
   "maxW": 2220
  },
  "noteReel": {
   "x": 2300,
   "y": 0,
   "w": 420,
   "size": "m",
   "fill": "orange",
   "text": "A 1930s-style cartoon short, new every day. Gil the emcee fish casts a line to wherever you point. Wrong guesses make him gasp. The answer arrives as an iris closing on the fish's home, the way old cartoons end.\n\nVerb: Cast. Each day is a Reel."
  },
  "titlePost": {
   "x": 0,
   "y": 990,
   "text": "B. Fish Post",
   "kind": "title1",
   "maxW": 2220
  },
  "notePost": {
   "x": 2300,
   "y": 1240,
   "w": 420,
   "size": "m",
   "fill": "blue",
   "text": "A lost fish has turned up at the sorting office in a knotted bag, and you have to address it home. The airmail stripes are made of fish. Clues are a customs form. The answer is a postcard the fish writes you, which is also the thing people share.\n\nVerb: Send."
  },
  "titleTank": {
   "x": 0,
   "y": 2230,
   "text": "C. The Tank",
   "kind": "title1",
   "maxW": 2220
  },
  "noteTank": {
   "x": 2300,
   "y": 2480,
   "w": 420,
   "size": "m",
   "fill": "pink",
   "text": "The whole screen is one strip-mall pet-shop tank, seen front on: black hood, fluorescent light, pink gravel, plastic castle. The map is painted on the back glass. Every fish you release adds a tank mate, so your streak is something you can watch swim.\n\nVerb: Release."
  },
  "noteSample": {
   "x": 2300,
   "y": 500,
   "w": 420,
   "size": "s",
   "fill": "gray",
   "text": "All boards use real data for the spotted handfish: real photo, sourced facts, real coastlines. The guess, score, streak, and day number are samples."
  },
  "r2Title1": {
   "x": 0,
   "y": -250,
   "text": "1. Plaice Reel (the conservative one)",
   "kind": "title1",
   "maxW": 2220,
   "page": "r2"
  },
  "r2Note1": {
   "x": 2300,
   "y": 0,
   "w": 440,
   "size": "m",
   "fill": "orange",
   "page": "r2",
   "text": "Direction A without the cartoon, set in a familiar daily-game frame. A Wordle-style header bar with a fish-scale trim, the photo in a film strip with printed edge codes, Worldle-style rows for each cast (distance, compass arrow, catch size), and a Wordle-style stats sheet on the answer. The cartoon iris stays, as a plain circle."
  },
  "r2Title2": {
   "x": 0,
   "y": 990,
   "text": "2. The Plaice Almanac (wild)",
   "kind": "title1",
   "maxW": 2220,
   "page": "r2"
  },
  "r2Note2": {
   "x": 2300,
   "y": 1240,
   "w": 440,
   "size": "m",
   "fill": "yellow",
   "page": "r2",
   "text": "A loud fishing almanac and newspaper puzzle page. The clues arrive as headlines, the guess log is a tide table, the map is the Chart of the Day, and the cast button is a coupon you clip. The answer screen is a late edition. The moon phase is real for the date."
  },
  "r2Title3": {
   "x": 0,
   "y": 2230,
   "text": "3. Plaice Specimens (wild)",
   "kind": "title1",
   "maxW": 2220,
   "page": "r2"
  },
  "r2Note3": {
   "x": 2300,
   "y": 2480,
   "w": 440,
   "size": "m",
   "fill": "teal",
   "page": "r2",
   "text": "Museum specimen tags and the IUCN Red List scale, crossed with the attribute grids from character-guessing games. Every cast is graded down a ladder of place: hemisphere, region, country, state. The tiles say YES or NO in words as well as colour. The colour notes are sampled from today's photo."
  },
  "r2Sample": {
   "x": 2300,
   "y": 520,
   "w": 440,
   "size": "s",
   "fill": "gray",
   "page": "r2",
   "text": "Sample game: cast 1 near Christchurch (2,043 km, home is west), cast 2 near Melbourne (606 km, south-southeast), cast 3 in the Derwent estuary. Distances and bearings are computed. Stats, streaks and the day number are samples."
  },
  "r3TitleTrim": {
   "x": 0,
   "y": -250,
   "text": "1. Front page, trimmed",
   "kind": "title1",
   "maxW": 2220,
   "page": "r3"
  },
  "r3NoteTrim": {
   "x": 2300,
   "y": 0,
   "w": 440,
   "size": "m",
   "fill": "orange",
   "page": "r3",
   "text": "Round 2's almanac with the noise taken out: no ticker, no side strapline, no joke copy. The masthead, the clue as headline, the chart of the day and the tide table stay. The coupon keeps its dashed edge but just says Cast."
  },
  "r3TitlePuzzle": {
   "x": 0,
   "y": 990,
   "text": "2. Puzzle page (calmest)",
   "kind": "title1",
   "maxW": 2220,
   "page": "r3"
  },
  "r3NotePuzzle": {
   "x": 2300,
   "y": 1240,
   "w": 440,
   "size": "m",
   "fill": "yellow",
   "page": "r3",
   "text": "The game sits in one boxed puzzle, the way a crossword sits on a newspaper puzzle page. Clues are numbered like crossword clues, casts are three big tiles, and there's a single coral action. Most white space, fewest colours."
  },
  "r3TitleTabloid": {
   "x": 0,
   "y": 2230,
   "text": "3. Tabloid (fewest words)",
   "kind": "title1",
   "maxW": 2220,
